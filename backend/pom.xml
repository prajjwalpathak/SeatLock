<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.3</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.seatlock</groupId>
	<artifactId>backend</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>SeatLock</name>
	<description>Flash-sale ticket booking platform with zero oversells</description>

	<properties>
		<java.version>25</java.version>
		<!-- W8·D5: the jackson-bom 3.1.8 override (CVE-2026-110879) was removed: Boot 4.1.3 manages 3.1.8 (ADR-001 item 5) -->
		<!-- SECURITY OVERRIDE: Tomcat 11.0.27 (Boot 4.1.3) → 11.0.29, same 11.0.x line. CVE-2026-116561, CVE-2026-118028,
		     CVE-2026-116830, CVE-2026-118233, CVE-2026-118436, CVE-2026-117517, CVE-2026-106012, CVE-2026-121649,
		     CVE-2026-116600 (WebSocket). Remove once Spring Boot manages >= 11.0.29. See docs/decisions/ADR-001. -->
		<tomcat.version>11.0.29</tomcat.version>
		<springdoc.version>3.2.0</springdoc.version>
		<jacoco.version>0.8.15</jacoco.version>
		<!-- empty default so @{argLine} resolves even when JaCoCo's agent is skipped (-Djacoco.skip) -->
		<argLine></argLine>
		<bucket4j.version>8.22.0</bucket4j.version>
		<!-- Test only. The standalone jar shades its own Jetty/Jackson, so it can't clash with Boot's versions. -->
		<wiremock.version>3.13.2</wiremock.version>
		<!-- W7·D1: Spring AI 2.0.x (Boot 4 line); W8·D5: 2.0.3 patch -->
		<spring-ai.version>2.0.3</spring-ai.version>
		<!-- resilience4j-spring-boot4 is NOT in resilience4j-bom 2.4.0 (upstream issue #2427), so pinned here -->
		<resilience4j.version>2.4.0</resilience4j.version>
	</properties>
	<dependencyManagement>
		<dependencies>
			<!-- SECURITY OVERRIDE: CVE-2026-102554 / GHSA-xxph-c9ww-hj94 (Guava deserialization, HIGH), fixed in 33.7.2.
			     Guava arrives transitively (AI libraries) and is not managed by Boot. Same -android flavour as before.
			     Remove when the libraries that bring it depend on >= 33.7.2. See docs/decisions/ADR-001. -->
			<dependency>
				<groupId>com.google.guava</groupId>
				<artifactId>guava</artifactId>
				<version>33.8.0-android</version>
			</dependency>
			<dependency>
				<groupId>org.springframework.ai</groupId>
				<artifactId>spring-ai-bom</artifactId>
				<version>${spring-ai.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>
	<dependencies>
		<!-- Rate limiting: token buckets stored in Redis (shared by all app instances). lettuce-core is
		     'provided' in this module, so it uses Boot's Lettuce (7.x); RateLimiterIntegrationTest proves it works. -->
		<dependency>
			<groupId>com.bucket4j</groupId>
			<artifactId>bucket4j_jdk17-lettuce</artifactId>
			<version>${bucket4j.version}</version>
		</dependency>
		<!-- AI (W7): Gemini through Spring AI's ChatClient. Off unless SEATLOCK_AI_PROVIDER=google-genai (ADR-016) -->
		<dependency>
			<groupId>org.springframework.ai</groupId>
			<artifactId>spring-ai-starter-model-google-genai</artifactId>
		</dependency>
		<!-- Local embeddings for RAG (W7·D4): ONNX Runtime + all-MiniLM-L6-v2 (384 dims). The model ships inside
		     the jar (classpath:/onnx/...), so it is baked into the image with no download. Off unless
		     SEATLOCK_EMBEDDINGS=transformers (ADR-017). -->
		<dependency>
			<groupId>org.springframework.ai</groupId>
			<artifactId>spring-ai-starter-model-transformers</artifactId>
		</dependency>
		<!-- Circuit breaker + time limiter around the LLM. The Boot 3 artifact must never be used: its verifier
		     bean throws IncompatibleSpringBootVersionException on Boot 4. Registries only (no AspectJ, no annotations). -->
		<dependency>
			<groupId>io.github.resilience4j</groupId>
			<artifactId>resilience4j-spring-boot4</artifactId>
			<version>${resilience4j.version}</version>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<dependency>
			<!-- /actuator/prometheus for the Prometheus scraper (W6·D2); version from Boot's BOM -->
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-registry-prometheus</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-redis</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-cache</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<!-- STOMP over WebSocket: live seat events (in-memory broker; Redis Pub/Sub relay on W5·D2) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-websocket</artifactId>
		</dependency>
		<!-- JWT validation (Nimbus); also brings JwtEncoder for issuing our own tokens -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security-oauth2-resource-server</artifactId>
		</dependency>
		<!-- "Sign in with Google" (authorization-code flow); ends in our own JWT -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security-oauth2-client</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>${springdoc.version}</version>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>

		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-redis-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Testcontainers (versions managed by the Spring Boot BOM) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-testcontainers</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Razorpay contract tests over real HTTP (W4·D5) -->
		<dependency>
			<groupId>org.wiremock</groupId>
			<artifactId>wiremock-standalone</artifactId>
			<version>${wiremock.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-postgresql</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
			<!-- Mockito's inline mock maker attaches itself at runtime, which JDK 21+ warns about ("dynamically loaded
     agent ... will be disallowed by default"). Load it as a real -javaagent instead (Mockito's documented setup):
     dependency:properties exposes the jar path as ${org.mockito:mockito-core:jar}. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<executions>
					<execution>
						<goals>
							<goal>properties</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<!-- @{argLine} = JaCoCo's agent (set late by prepare-agent); -Xshare:off avoids the CDS warning agents cause -->
					<argLine>@{argLine} -javaagent:${org.mockito:mockito-core:jar} -Xshare:off</argLine>
				</configuration>
			</plugin>
			<!-- Test coverage: agent during tests, HTML/XML/CSV report in target/site/jacoco on 'verify', then a gate:
     'verify' (and CI) FAILS below 85 % lines or 80 % branches for the whole backend (W6·D1; was 94.0 % / 81.2 %).
     Raise the floors when coverage grows; never lower them to make a build pass. -->
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>${jacoco.version}</version>
				<configuration>
					<excludes>
						<!-- bootstrap only; nothing to test -->
						<exclude>com/seatlock/SeatLockApplication.class</exclude>
						<!-- pure wiring of the job scheduler; jobs are disabled in the test profile and called directly -->
						<exclude>com/seatlock/common/config/SchedulingConfig.class</exclude>
						<!-- thin Spring AI adapter: needs a live model (checked by /admin/ai/ping and the W7·D6 drills);
						     the guardrails around it are unit-tested with stub LlmClients -->
						<exclude>com/seatlock/assistant/ai/GeminiLlmClient.class</exclude>
					</excludes>
				</configuration>
				<executions>
					<execution>
						<id>prepare-agent</id>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>report</id>
						<phase>verify</phase>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
					<!-- runs after 'report', so the HTML report exists even when the gate fails -->
					<execution>
						<id>coverage-gate</id>
						<phase>verify</phase>
						<goals>
							<goal>check</goal>
						</goals>
						<configuration>
							<haltOnFailure>true</haltOnFailure>
							<rules>
								<rule>
									<element>BUNDLE</element>
									<limits>
										<limit>
											<counter>LINE</counter>
											<value>COVEREDRATIO</value>
											<minimum>0.85</minimum>
										</limit>
										<limit>
											<counter>BRANCH</counter>
											<value>COVEREDRATIO</value>
											<minimum>0.80</minimum>
										</limit>
									</limits>
								</rule>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
