# Copy to .env.local for local overrides (git-ignored). Vite exposes only VITE_* variables to the browser,
# so never put secrets here.
VITE_API_BASE_URL=http://localhost:8080
# "true" shows Continue with Google (the OAuth app is in testing mode: only its test users can sign in).
# Leave unset on Vercel so public visitors never hit Google's "access blocked" page.
VITE_GOOGLE_SIGNIN=true
