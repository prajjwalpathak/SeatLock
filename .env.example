# Copy to .env (git-ignored) and fill in real values. Never commit .env.

# ---- Postgres ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=seatlock
POSTGRES_USER=seatlock
POSTGRES_PASSWORD=change-me

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- JWT (RS256 key pair; base64 on ONE line, no BEGIN/END lines) ----
# Generate in PowerShell (OpenSSL ships with Git for Windows), then delete the .pem files:
#   $ssl = "C:\Program Files\Git\usr\bin\openssl.exe"
#   & $ssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt-private.pem
#   & $ssl pkey -in jwt-private.pem -pubout -out jwt-public.pem
#   (Get-Content jwt-private.pem | Where-Object { $_ -notmatch '-----' }) -join ''   # → JWT_PRIVATE_KEY
#   (Get-Content jwt-public.pem  | Where-Object { $_ -notmatch '-----' }) -join ''   # → JWT_PUBLIC_KEY
# Use a different pair in prod. Tests ignore these (they generate their own).
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# ---- Bootstrap admin: created at startup if missing (never promotes an existing account) ----
# Password: 12+ characters. Leave both empty to skip. Use different values in prod.
SEATLOCK_ADMIN_EMAIL=
SEATLOCK_ADMIN_PASSWORD=

# ---- Google sign-in (OAuth client: Google Auth Platform → Clients → Web application) ----
# Redirect URI to register: http://localhost:8080/login/oauth2/code/google (prod URI added on W2·D5)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Seat locking strategy (W4·D6): redis-hold (default, Lua + TTL) | optimistic (Postgres conditional upserts) ----
SEATLOCK_HOLDS_STRATEGY=redis-hold

# ---- Razorpay test mode (W4·D2) ----
# dashboard.razorpay.com → Test mode → Account & Settings → API Keys → Generate Test Key.
# Only rzp_test_ keys are accepted. Set SEATLOCK_PAYMENTS_GATEWAY=razorpay to use them (default: mock).
SEATLOCK_PAYMENTS_GATEWAY=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Test mode → Accounts & Settings → Webhooks → Add: URL https://<tunnel>/api/v1/webhooks/razorpay, your own secret
RAZORPAY_WEBHOOK_SECRET=

# ---- AI (W7·D1): Gemini Developer API key from https://aistudio.google.com/apikey (personal Google account) ----
# SEATLOCK_AI_PROVIDER: google-genai = on, none (default) = AI features use their non-AI fallbacks.
# Free-tier prompts may be used by Google to improve its products: SeatLock never sends names or e-mails.
SEATLOCK_AI_PROVIDER=google-genai
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Gemini 3.x reasoning effort: LOW (default) | HIGH | THINKING_LEVEL_UNSPECIFIED (model decides; use if a model rejects LOW)
GEMINI_THINKING_LEVEL=LOW
# RAG (W7·D4): transformers = local ONNX embeddings (all-MiniLM-L6-v2, inside the jar, no key), none = off
SEATLOCK_EMBEDDINGS=transformers

# ---- Prod only (local uses application-local.yml) ----
# CORS_ALLOWED_ORIGINS=https://seatlock.vercel.app
# FRONTEND_BASE_URL=https://seatlock.vercel.app      (Google sign-in redirects back here)
# ---------- Monitoring (W6·D2, local Grafana at http://localhost:3000, user admin) ----------
# Optional locally (defaults to "admin"); prod generates its own in infra/.env.prod.
GRAFANA_ADMIN_PASSWORD=grafana

# ---------- Demo upkeep (W8·D1, ADR-019) ----------
# Nightly 03:30 IST: top up seed events' shows + reset the shared demo account. false = off.
SEATLOCK_DEMO_RESET_ENABLED=true
