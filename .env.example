# Copy to .env (git-ignored) and fill in real values. Never commit .env.

# ---- Postgres ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=seatlock
POSTGRES_USER=seatlock
POSTGRES_PASSWORD=change-me

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- JWT (RS256 key pair; base64 on ONE line, no BEGIN/END lines) ----
# Generate in PowerShell (OpenSSL ships with Git for Windows), then delete the .pem files:
#   $ssl = "C:\Program Files\Git\usr\bin\openssl.exe"
#   & $ssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt-private.pem
#   & $ssl pkey -in jwt-private.pem -pubout -out jwt-public.pem
#   (Get-Content jwt-private.pem | Where-Object { $_ -notmatch '-----' }) -join ''   # → JWT_PRIVATE_KEY
#   (Get-Content jwt-public.pem  | Where-Object { $_ -notmatch '-----' }) -join ''   # → JWT_PUBLIC_KEY
# Use a different pair in prod. Tests ignore these (they generate their own).
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# ---- Bootstrap admin: created at startup if missing (never promotes an existing account) ----
# Password: 12+ characters. Leave both empty to skip. Use different values in prod.
SEATLOCK_ADMIN_EMAIL=
SEATLOCK_ADMIN_PASSWORD=

# ---- Prod only (local uses application-local.yml) ----
# CORS_ALLOWED_ORIGINS=https://seatlock.vercel.app