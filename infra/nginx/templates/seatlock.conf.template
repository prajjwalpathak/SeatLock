# Rendered by the nginx image at startup (envsubst): only ${DOMAIN} is replaced,
# because it is the only variable defined in the container's environment.
# Nginx's own $variables are left untouched.

# Brute-force guard for login/register: 10 requests/min per client IP (burst 5).
limit_req_zone $binary_remote_addr zone=auth:10m rate=10r/m;
limit_req_status 429;

# WebSocket upgrade: "upgrade" for handshakes, empty otherwise so plain requests keep upstream keep-alive.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      '';
}

# Docker's DNS, re-resolved at runtime: a redeployed app container with a new IP doesn't leave Nginx on a stale one.
resolver 127.0.0.11 valid=10s ipv6=off;

# Two app instances (W5·D5), same rules as infra/nginx/local/seatlock-lb.conf (docs/local-scale.md).
upstream seatlock_app {
    zone seatlock_app 64k;                    # shared memory: required for "resolve"
    # Round robin; one failed connect takes an instance out for 5 s (e.g. while deploy.sh replaces it).
    server app-1:8080 resolve max_fails=1 fail_timeout=5s;
    server app-2:8080 resolve max_fails=1 fail_timeout=5s;
    keepalive 16;
}

server_tokens off;

# ---------- HTTP: ACME challenge + redirect everything else to HTTPS ----------
server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ---------- HTTPS: reverse proxy to the two Spring Boot instances ----------
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    client_max_body_size 1m;

    gzip on;
    gzip_types application/json application/problem+json text/plain text/css application/javascript;
    gzip_min_length 1024;

    # Shared proxy settings (inherited by the locations below).
    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host  $host;
    proxy_set_header X-Forwarded-Port  $server_port;
    proxy_set_header Upgrade           $http_upgrade;
    proxy_set_header Connection        $connection_upgrade;
    proxy_connect_timeout 2s;
    proxy_read_timeout    60s;
    # A failed connect moves the request to the other instance; never once a POST/DELETE was sent.
    proxy_next_upstream error timeout;

    # Health is public (uptime checks); every other actuator endpoint is hidden at the edge.
    location /actuator/health {
        proxy_pass http://seatlock_app;
    }
    location /actuator/ {
        return 404;      # includes /actuator/prometheus: scraped only on the Docker network
    }

    # Grafana (W6·D2): its own login (admin from .env.prod), served from the /grafana/ sub-path.
    # Through a variable so Nginx still starts if Grafana is down (resolved at request time by Docker DNS).
    location /grafana/ {
        set $grafana_upstream http://grafana:3000;
        proxy_pass $grafana_upstream;
        proxy_read_timeout 75s;      # Grafana Live (WebSocket) keeps a connection open
    }

    location ~ ^/api/v1/auth/(login|register)$ {
        limit_req zone=auth burst=5 nodelay;
        proxy_pass http://seatlock_app;
    }

    # STOMP over WebSocket: long-lived, pinned to the instance that accepted it. 10 s heart-beats both ways,
    # so 75 s of silence means the connection is dead.
    location /ws {
        proxy_pass http://seatlock_app;
        proxy_read_timeout 75s;
        proxy_send_timeout 75s;
    }

    location / {
        proxy_pass http://seatlock_app;
    }
}
