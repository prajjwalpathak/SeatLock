# Copy to infra/.env.prod ON THE VM and fill in. Never commit the real file.
#   cp infra/.env.prod.example infra/.env.prod && chmod 600 infra/.env.prod
# No quotes around values, no trailing comments, and NO "$" in values: Docker Compose treats "$Name" as a variable
# and silently replaces it (warning: The "Name" variable is not set). Generate secrets with: openssl rand -hex 32

# ---------- Domain / TLS ----------
DOMAIN=seatlock-prajjwal.duckdns.org
LETSENCRYPT_EMAIL=you@example.com

# ---------- Postgres (container-internal; never published) ----------
POSTGRES_DB=seatlock
POSTGRES_USER=seatlock
POSTGRES_PASSWORD=change-me-long-random

# ---------- JWT (RS256, base64 DER on one line; generate a NEW pair for prod) ----------
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# ---------- Bootstrap ADMIN (created once at first start) ----------
SEATLOCK_ADMIN_EMAIL=
SEATLOCK_ADMIN_PASSWORD=

# ---------- Google sign-in (add the prod redirect URI in Google Cloud Console) ----------
# https://seatlock-prajjwal.duckdns.org/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Payments (Razorpay TEST mode only; rzp_live_ keys are refused at startup) ----------
# mock until checkout verification lands (W4·D3); then razorpay. Keys: dashboard.razorpay.com → Test mode → API Keys
SEATLOCK_PAYMENTS_GATEWAY=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook URL in the dashboard: https://seatlock-prajjwal.duckdns.org/api/v1/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=

# ---------- Frontend (Vercel) ----------
FRONTEND_BASE_URL=https://your-app.vercel.app
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app

# ---------- Backend image (managed by infra/scripts/deploy.sh; don't edit by hand) ----------
APP_IMAGE=ghcr.io/prajjwalpathak/seatlock-backend:latest

# ---------- Feature flags ----------
SEATLOCK_CACHE_ENABLED=true
