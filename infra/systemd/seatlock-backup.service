# Nightly Postgres backup (W8·D2). Installed by docs/deploy.md section 5b:
#   sudo cp ~/seatlock/infra/systemd/seatlock-backup.* /etc/systemd/system/ && sudo systemctl daemon-reload
#   sudo systemctl enable --now seatlock-backup.timer
[Unit]
Description=SeatLock nightly Postgres backup
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=ubuntu
ExecStart=/bin/bash /home/ubuntu/seatlock/infra/scripts/backup.sh
Nice=10
IOSchedulingClass=idle
